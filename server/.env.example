# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 공유하거나 저장소에 올리지 마세요.

# Claude API 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=

# 메일 비밀번호 암호화 키. 아래 명령으로 만들어 넣으세요. 잃어버리면 저장된 메일 계정을 다시 등록해야 합니다.
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
MAIL_ENC_KEY=

# 첫 실행 때 만들어지는 관리자 계정 (사용자가 한 명도 없을 때만 적용, 비밀번호 8자 이상)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 휴대폰/브라우저 푸시 알림. 세 값이 모두 있어야 켜집니다. 키는 아래 명령으로 만듭니다.
#   docker run --rm jason191188/webmail:latest python -m app.vapidgen
# 키를 바꾸면 모든 기기에서 알림을 다시 켜야 합니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스(구글, 애플 등)가 문제 발생 시 연락할 주소. mailto: 로 시작해야 합니다.
VAPID_SUBJECT=mailto:관리자메일주소

# 선택 설정
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# 메일함 확인 주기(초). 메일 서버의 로그인 간격 제한이 10초라서 60초면 안전하다. 최소 15.
POLL_INTERVAL_SEC=60
SESSION_DAYS=30
# 한 달 Claude API 환산 비용 한도(달러). 넘으면 새 요약 요청을 막는다. 0 이면 한도 없음.
MONTHLY_BUDGET_USD=0
# 받은 지 이 일수가 지난 메일(요약, 답장 기록 포함)을 자동으로 지운다. 0 이면 지우지 않음.
MAIL_RETENTION_DAYS=90
# 자동 백업(하루 한 번, data/backups)을 몇 개까지 보관할지
BACKUP_KEEP=7
# API 문서 화면(/docs)을 열지 여부. 운영에서는 false 권장.
DOCS_ENABLED=false
